# Server Configuration
PORT=5000
NODE_ENV=development

# AI API Keys (Optional - Platform works without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=

# AI Configuration
USE_LOCAL_MODEL=true
ENABLE_API_FALLBACK=true
ENABLE_CACHE=true

# Security
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
